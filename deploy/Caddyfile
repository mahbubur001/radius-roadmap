# Caddy config for the EC2 box. Copy to /etc/caddy/Caddyfile and replace
# app.example.com with the real app domain.
{
	email ops@example.com
	# Public sites (<account>.<PUBLIC_ROOT_DOMAIN>, later custom domains):
	# Caddy asks the app before issuing each certificate.
	on_demand_tls {
		ask http://localhost:3000/api/internal/domain-check
	}
}

# The dashboard.
app.example.com {
	encode zstd gzip
	reverse_proxy localhost:3000
}

# Public sites: account subdomains (point *.<PUBLIC_ROOT_DOMAIN> at this
# server) and, from Phase 6, customer custom domains.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy localhost:3000
}
