# Copy to .env.local and fill in. Never commit .env.local.

# --- Database / Redis ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/radius_roadmap
REDIS_URL=redis://localhost:6379

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: "Sign in with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---
# console = dev only: print to the worker log and save to .dev-mail/*.json
# smtp = Mailpit locally (http://localhost:8025) or a custom SMTP server
# ses  = Amazon SES (production; credentials from the EC2 instance role)
EMAIL_TRANSPORT=console
EMAIL_FROM=Radius Roadmap <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
AWS_REGION=us-east-1
