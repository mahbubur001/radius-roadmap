# Copy to .env.local and fill in. Never commit .env.local.

# --- Database / Redis ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/radius_roadmap
REDIS_URL=redis://localhost:6379

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: "Sign in with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---
# Email always goes through Amazon SES, also in development (owner,
# 2026-11-01). EMAIL_FROM must be a verified SES identity; while the SES
# account is in the sandbox, recipients must be verified too. Locally, set
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (on EC2 the instance role is used).
EMAIL_FROM="Radius Roadmap <no-reply@yourdomain.com>"
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- File uploads: Cloudflare R2, everywhere (doc 29 T11) ---
# See the R2 block below; without it, uploads fail with a clear error.

# --- Public sites + voting (Phase 2) ---
# Public sites are served on the app domain at /<account>/<workspace>,
# e.g. http://localhost:3000/acme/my-product/roadmap
# Signs the anonymous visitor cookie and hashes voter IPs (openssl rand -base64 32).
# Optional: derived from BETTER_AUTH_SECRET when empty.
VISITOR_SECRET=
# Cloudflare Turnstile on anonymous/guest votes. Leave both empty to skip the
# check (dev). Cloudflare's always-pass test keys:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 1 = the app is behind Cloudflare: trust cf-connecting-ip (vote rate limits)
# and cf-ipcountry/cf-ipcity (geo). Leave 0 otherwise, or clients can fake them.
TRUST_CLOUDFLARE=0

# Stripe billing (test mode keys locally). Leave empty to turn billing off:
# every account is then unlimited and Settings → Billing is hidden.
# Webhook secret for local dev: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Custom domains (doc 26 6D): hostname customers point a CNAME at, e.g.
# domains.app.example.com (its own DNS record points at this server).
# Unset = custom domains off; in development *.localhost hosts work without it.
CUSTOM_DOMAIN_TARGET=

# Platform admins (doc 28): comma-separated emails that can open /admin
# (accounts, plan overrides, customer invites, suspension). Verified emails
# only. The e2e test signs in as platform-admin@example.test.
PLATFORM_ADMIN_EMAILS=

# Cloudflare R2 (doc 29 T11): the only file storage, also in development.
# Create a bucket, give it a public custom domain (or r2.dev for testing), add
# a CORS rule allowing PUT and GET from the app origins (http://localhost:3000
# too) with the content-type and content-disposition headers, and an API token
# with Object Read & Write on that bucket. R2_PUBLIC_URL = the public address.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
