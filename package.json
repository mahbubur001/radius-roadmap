{
  "name": "radius-roadmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "worker:dev": "tsx watch --env-file=.env.local worker.ts",
    "widget:dev": "vite build --config widget/vite.config.ts --watch",
    "build": "pnpm build:widget && pnpm build:web && pnpm build:worker",
    "build:web": "next build",
    "build:worker": "tsup worker.ts --format esm --target node22 --out-dir dist --clean",
    "build:widget": "vite build --config widget/vite.config.ts",
    "start": "next start",
    "start:worker": "node --env-file-if-exists=.env.local dist/worker.js",
    "check": "biome check --write",
    "lint": "biome check",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p widget",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "dotenv -e .env.local -- auth generate --config src/server/auth/index.ts --output src/server/db/schema/auth.ts --adapter drizzle --dialect postgresql --yes && biome check --write src/server/db/schema/auth.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1157.0",
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@hookform/resolvers": "^6.0.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "^1.7.14",
    "bullmq": "^6.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "ioredis": "^5.11.1",
    "jose": "^6.2.13",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "^6.11.3",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.2",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "auth": "^1.7.14",
    "dotenv": "^18.0.9",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "preact": "^11.1.0",
    "tailwindcss": "^4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
