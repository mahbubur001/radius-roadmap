# Copy to .env.local and fill in. Never commit .env.local.

# --- Database / Redis ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/radius_roadmap
REDIS_URL=redis://localhost:6379

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: "Sign in with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---
# console = dev only: print to the worker log and save to .dev-mail/*.json
# smtp = Mailpit locally (http://localhost:8025) or a custom SMTP server
# ses  = Amazon SES (production; credentials from the EC2 instance role)
EMAIL_TRANSPORT=console
EMAIL_FROM=Radius Roadmap <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
AWS_REGION=us-east-1

# --- File uploads ---
# local = files saved in UPLOAD_DIR and served by /api/files (dev)
# s3    = presigned uploads to S3_BUCKET, served from S3_PUBLIC_URL (production)
STORAGE_DRIVER=local
UPLOAD_DIR=.uploads
S3_BUCKET=
S3_PUBLIC_URL=

# --- Public sites + voting (Phase 2) ---
# Public sites are served on the app domain at /<account>/<workspace>,
# e.g. http://localhost:3000/acme/my-product/roadmap
# Signs the anonymous visitor cookie and hashes voter IPs (openssl rand -base64 32).
# Optional: derived from BETTER_AUTH_SECRET when empty.
VISITOR_SECRET=
# Cloudflare Turnstile on anonymous/guest votes. Leave both empty to skip the
# check (dev). Cloudflare's always-pass test keys:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 1 = the app is behind Cloudflare: trust cf-connecting-ip (vote rate limits)
# and cf-ipcountry/cf-ipcity (geo). Leave 0 otherwise, or clients can fake them.
TRUST_CLOUDFLARE=0
