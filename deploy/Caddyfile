# Caddy config for the EC2 box. Copy to /etc/caddy/Caddyfile and replace
# app.example.com with the real app domain.
{
	email ops@example.com
	# Custom domains: Caddy asks the app before issuing a certificate.
	on_demand_tls {
		ask http://localhost:3000/api/internal/domain-check
	}
}

# The dashboard and the default public sites.
app.example.com {
	encode zstd gzip
	reverse_proxy localhost:3000
}

# Any other hostname pointed at this server (customer custom domains).
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy localhost:3000
}
