# Caddy config for the EC2 box. Copy to /etc/caddy/Caddyfile and replace
# app.example.com with the real app domain.
{
	email ops@example.com

	# Customer domains (doc 26 6D): before issuing a certificate for a host it
	# doesn't know, Caddy asks the app. 200 = a live, plan-allowed domain.
	on_demand_tls {
		ask http://localhost:3000/api/domain-check
	}
}

# The dashboard and every public site (/<account>/<workspace>, doc 19 D1
# revised).
app.example.com {
	encode zstd gzip
	reverse_proxy localhost:3000
}

# Customers' own domains (doc 26 6D). They CNAME their host to the
# CUSTOM_DOMAIN_TARGET hostname (e.g. domains.app.example.com, an A record
# for this server). The certificate is issued on the first visit; src/proxy.ts
# serves only that account's public site there.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy localhost:3000
}
